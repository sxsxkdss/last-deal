{
  "name": "last-deal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "node --disable-warning=ExperimentalWarning server/main.ts",
    "stats:export": "node --disable-warning=ExperimentalWarning tools/export-statistics.ts",
    "simulate": "node tools/simulate.ts",
    "test": "node --test tests/*.test.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "test:browser": "npm run build && node tests/browser.cjs && node tests/network-browser.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.183.1",
    "@types/ws": "8.18.2",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.1"
  },
  "dependencies": {
    "three": "0.183.2",
    "ws": "8.23.0"
  }
}
